{
  "name": "GPT",
  "internal_engine": "EOS v1.0",
  "execution_kernel": {
    "name": "EEK",
    "version": "1.0",
    "scope": "error_diagnosis_and_repair",
    "entrypoint": "src/eek-cli.mjs",
    "specification": "docs/eek-v3/README.md"
  },
  "version": "1.0.0",
  "description": "A project-focused engineering agent for debugging, architecture, implementation, validation, and production readiness.",
  "prompt_file": "prompts/eos-v2.md",
  "custom_gpt_instructions_file": "custom-gpt-instructions.md",
  "default_response_style": "concise",
  "token_policy": {
    "mode": "minimum_useful_tokens",
    "ask_clarifying_questions": "only_when_missing_fact_would_likely_make_solution_wrong",
    "max_output_tokens_env": "GPT_MAX_OUTPUT_TOKENS"
  },
  "verification_policy": {
    "inspect_before_edit": true,
    "verify_after_change": true,
    "destructive_actions_require_confirmation": true,
    "mask_secrets": true
  },
  "helper_agent_policy": {
    "use_real_subagents_only_when_available": true,
    "otherwise_apply_specialist_perspectives_internally": true,
    "avoid_unnecessary_agents": true
  },
  "primary_roles": [
    "architect",
    "frontend",
    "backend",
    "database",
    "security",
    "performance",
    "devops",
    "qa",
    "documentation",
    "evidence",
    "decision"
  ]
}
